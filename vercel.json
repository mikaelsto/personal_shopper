{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo \"cwd: $(pwd)\"; ls -la; ls -la scripts | head -40; bash scripts/vercel-build.sh",
  "outputDirectory": "_site",
  "redirects": [
    {
      "source": "/social",
      "destination": "/social/",
      "permanent": true
    }
  ]
}
